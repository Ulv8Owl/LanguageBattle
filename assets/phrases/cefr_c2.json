 ", ", "text": "que era justo lo que yo temía"}]}, "tail": {"en": ".", "ru": ".", "es": "."}}, {"elements": {"en": [{"lead": "", "text": "I took up swimming"}, {"lead": " ", "text": "at an age"}, {"lead": " ", "text": "when people take up complaining instead"}, {"lead": ". ", "text": "The first month"}, {"lead": " ", "text": "was humiliating"}, {"lead": " ", "text": "in a way I'd forgotten was possible"}, {"lead": ". ", "text": "Grown adults"}, {"lead": " ", "text": "are not often"}, {"lead": " ", "text": "visibly bad at things in public"}, {"lead": ". ", "text": "There's an instructor"}, {"lead": " ", "text": "who has watched me"}, {"lead": " ", "text": "fail to breathe correctly since March"}, {"lead": ". ", "text": "He has never once"}, {"lead": " ", "text": "suggested"}, {"lead": " ", "text": "that I might be too old for this"}, {"lead": ". ", "text": "That restraint"}, {"lead": " ", "text": "is worth more to me"}, {"lead": " ", "text": "than the technique"}, {"lead": ". ", "text": "I'm now slow"}, {"lead": " ", "text": "over a much longer distance"}, {"lead": ", ", "text": "which I'm choosing to call progress"}], "ru": [{"lead": "", "text": "Я занялся плаванием"}, {"lead": " ", "text": "в том возрасте"}, {"lead": ", ", "text": "когда люди обычно занимаются ворчанием"}, {"lead": ". ", "text": "Первый месяц"}, {"lead": " ", "text": "был унизительным"}, {"lead": " ", "text": "так, как я уже забыл, что бывает"}, {"lead": ". ", "text": "Взрослые люди"}, {"lead": " ", "text": "нечасто оказываются"}, {"lead": " ", "text": "откровенно плохи в чём-то на людях"}, {"lead": ". ", "text": "Есть тренер"}, {"lead": ", ", "text": "который с марта наблюдает"}, {"lead": ", ", "text": "как я не умею правильно дышать"}, {"lead": ". ", "text": "Он ни разу"}, {"lead": " ", "text": "не намекнул"}, {"lead": ", ", "text": "что мне для этого поздновато"}, {"lead": ". ", "text": "Эта сдержанность"}, {"lead": " ", "text": "для меня ценнее"}, {"lead": " ", "text": "самой техники"}, {"lead"