lead": ". ", "text": "I've stopped pretending"}, {"lead": " ", "text": "that the value"}, {"lead": " ", "text": "is in the slides"}, {"lead": ". ", "text": "It's in the room"}, {"lead": ", ", "text": "and the slides"}, {"lead": " ", "text": "are just what we do with our hands"}], "ru": [{"lead": "", "text": "Половина моей работы"}, {"lead": " — ", "text": "говорить людям то"}, {"lead": ", ", "text": "что они и так знают"}, {"lead": ". ", "text": "Вторая половина"}, {"lead": " — ", "text": "быть тем человеком"}, {"lead": ", ", "text": "которому это позволено произнести вслух"}, {"lead": ". ", "text": "Никто"}, {"lead": " ", "text": "не платит за анализ"}, {"lead": ", ", "text": "платят за разрешение"}, {"lead": ". ", "text": "Звучит цинично"}, {"lead": ", ", "text": "и примерно год"}, {"lead": " ", "text": "мне от этого было тошно"}, {"lead": ". ", "text": "Потом я заметил"}, {"lead": ", ", "text": "что решения действительно менялись"}, {"lead": ", ", "text": "а это больше, чем достигает большинство отчётов"}, {"lead": ". ", "text": "Я перестал делать вид"}, {"lead": ", ", "text": "что ценность"}, {"lead": " ", "text": "находится в слайдах"}, {"lead": ". ", "text": "Она в комнате"}, {"lead": ", ", "text": "а слайды"}, {"lead": " — ", "text": "это просто то, чем заняты наши руки"}], "es": [{"lead": "", "text": "La mitad de mi trabajo"}, {"lead": " ", "text": "consiste en decirle a la gente cosas"}, {"lead": " ", "text": "que ya sabe"}, {"lead": ". ", "text": "La otra mitad"}, {"lead": " ", "text": "es ser"}, {"lead": " ", "text": "la persona a la que se le permite decirlas"}, {"lead": ". ", "text": "Nadie paga"}, {"lead": " ", "text": "por el análisis"}, {"lead": "; ", "text": "pagan por el permiso"}, {"lead": ". ", "text": "Suena cínico"}, {"lead": ", ", "text": "y durante casi un año"}, {"lead": " ", "text": "me hizo sentir fatal"}, {"lead": ". ", "text": "Luego me di cuenta"}, {"lead": " ", "text": "de que las decisiones cambiaban de verdad"}, {"lead": ", ", "text": "que es más de lo que consigue la mayoría de los informes"}, {"lead": ". ", "text": "He dejado de fingir"}, {"lead": " ", "text": "que el valor"}, {"lead": " ", "text": "está en las diapositivas"}, {"lead": ". ", "text": "Está en la sala"}, {"lead": ", ", "text": "y las diapositivas"}, {"lead": " ", "text": "son solo lo que hacemos con las manos"}]}, "tail": {"en": ".", "ru": ".", "es": "."}}, {"elements": {"en": [{"lead": "", "text": "Somebody asked me recently"}, {"lead": " ", "text": "what I'd tell myself"}, {"lead": " ", "text": "at twenty-five"}, {"lead": ". ", "text": "The honest answer"}, {"lead": " ", "text": "is that he wouldn't have listened"}, {"lead": ", ", "text": "and he'd have been right not to"}, {"lead": ". ", "text": "Most of what I know now"}, {"lead": " ", "text": "I know because I ignored"}, {"lead": " ", "text": "exactly that kind of advice"}, {"lead": ". ", "text": "The mistakes"}, {"lead": " ", "text": "were not detours"}, {"lead": "; ", "text": "they were the road"}, {"lead": ". ", "text": "That said"}, {"lead": ", ", "text": "I'd probably mention"}, {"lead": " ", "text": "the thing about sleep"}, {"lead": ". ", "text": "He'd have laughed"}, {"lead": ", ", "text": "made a note"}, {"lead": " ", "text": "and forgotten it by Thursday"}, {"lead": ". ", "text": "Which is, more or less"}, {"lead": ", ", "text": "what I did"}, {"lead": " ", "text": "with everything I was told"}], "ru": [{"lead": "", "text": "Недавно меня спросили"}, {"lead": ", ", "text": "что бы я сказал себе"}, {"lead": " ", "text": "в двадцать пять"}, {"lead": ". ", "text": "Честный ответ"}, {"lead": " — ", "text": "что он бы не послушал"}, {"lead": ", ", "text": "и правильно бы сделал"}, {"lead": ". ", "text": "Почти всё, что я знаю сейчас"}, {"lead": ", ", "text": "я знаю потому, что проигнорировал"}, {"lead": " ", "text": "ровно такие советы"}, {"lead": ". ", "text": "Ошибки"}, {"lead": " ", "text": "не были обходными путями"}, {"lead": ", ", "text": "они и были дорогой"}, {"lead": ". ", "text": "При этом"}, {"lead": " ", "text": "я, наверное, всё-таки упомянул бы"}, {"lead": " ", "text": "историю про сон"}, {"lead": ". ", "text": "Он бы посмеялся"}, {"lead": ", ", "text": "что-то записал"}, {"lead": " ", "text": "и забыл к четвергу"}, {"lead": ". ", "text": "Что, в общем-то"}, {"lead": ", ", "text": "я и сделал"}, {"lead": " ", "text": "со всем, что мне тогда говорили"}], "es": [{"lead": "", "text": "Hace poco me preguntaron"}, {"lead": " ", "text": "qué me diría a mí mismo"}, {"lead": " ", "text": "a los veinticinco"}, {"lead": ". ", "text": "La respuesta honesta"}, {"lead": " ", "text": "es que no me habría hecho caso"}, {"lead": ", ", "text": "y habría hecho bien"}, {"lead": ". ", "text": "Casi todo lo que sé ahora"}, {"lead": " ", "text": "lo sé porque ignoré"}, {"lead": " ", "text": "justamente ese tipo de consejos"}, {"lead": ". ", "text": "Los errores"}, {"lead": " ", "text": "no fueron desvíos"}, {"lead": "; ", "text": "eran el camino"}, {"lead": ". ", "text": "Dicho esto"}, {"lead": " ", "text": "probablemente sí mencionaría"}, {"lead": " ", "text": "lo del sueño"}, {"lead": ". ", "text": "Se habría reído"}, {"lead": ", ", "text": "habría tomado nota"}, {"lead": " ", "text": "y lo habría olvidado para el jueves"}, {"lead": ". ", "text": "Que es, más o menos"}, {"lead": ", ", "text": "lo que hice yo"}, {"lead": " ", "text": "con todo lo que me dijeron"}]}, "tail": {"en": ".", "ru": ".", "es": "."}}]
