<?xml version="1.0" encoding="utf-8"?>
<!-- Что нельзя выбрасывать при сжатии ресурсов.

     Значок уведомления и звук ищутся ПО ИМЕНИ, в рантайме: в коде на них
     нет ни одной ссылки, которую увидел бы R8. Для него это мусор, и
     выбросит он их молча — уведомление после этого либо приходит без
     значка, либо не приходит вовсе. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@raw/reminder,
                @drawable/notification_bg_*,@layout/notification_chrolingo,
                @id/reminder_*,
                @drawable/mascot_*,@drawable/widget_bg_*,@drawable/widget_preview,
                @layout/widget_chrolingo,@xml/chrolingo_widget_info,
                @id/widget_*" />
