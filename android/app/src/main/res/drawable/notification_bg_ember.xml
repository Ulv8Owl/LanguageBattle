<!-- Подложка уведомления. БЕЗ СКРУГЛЕНИЯ НАРОЧНО.

     Без setStyle уведомление наше целиком, от края до края, и форму ему
     задаёт сама шторка: она обрезает карточку так, как принято на этой
     прошивке. Своё скругление поверх этого — вторые углы внутри чужих,
     и выглядит это хуже, чем прямоугольник. Проверено на телефоне.

     На Android 12+ система накрывает уведомление своим шаблоном, и там
     это станет прямоугольной плашкой внутри её карточки — сознательный
     размен в пользу прошивок, где уведомление наше целиком. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E23B5A" />
</shape>
