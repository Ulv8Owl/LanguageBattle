<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет на рабочем столе.

     ЗДЕСЬ НЕТ ШАПКИ, И В ЭТОМ ВЕСЬ СМЫСЛ. Уведомление с Android 12
     обязано нести шапку системы с именем приложения — у виджета такой
     шапки нет ни у кого: всё пространство наше, включая фон.

     Ограничения те же, что у уведомления: RemoteViews принимает лишь
     горстку виджетов (LinearLayout, TextView, ImageView, Chronometer и
     ещё несколько). ConstraintLayout и androidx-виджеты собираются
     успешно и падают на телефоне.

     Значения по умолчанию заданы прямо здесь: их показывает превью в
     списке виджетов, где приложение ещё ничего не успело прислать. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gold"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#0D0D10"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title_default"
            android:textColor="#0D0D10"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/widget_body_default"
            android:textColor="#CC0D0D10"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot_waiting" />
</LinearLayout>
