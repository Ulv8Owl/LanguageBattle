<?xml version="1.0" encoding="utf-8"?>
<!-- Своя разметка уведомления.

     ЗДЕСЬ МОЖНО НЕ ВСЁ. RemoteViews принимает лишь горстку виджетов
     (FrameLayout, LinearLayout, RelativeLayout, GridLayout + TextView,
     ImageView, Button, ProgressBar, Chronometer и ещё несколько). Ни
     ConstraintLayout, ни любой androidx-виджет сюда класть нельзя: они
     не упадут на сборке, они упадут на телефоне надписью «не удалось
     показать уведомление».

     ЭТО БОЛЬШОЙ ВИД: всплывающее уведомление и развёрнутое в шторке.
     Свёрнутому на Android 12+ достаётся 48dp — для него есть отдельная
     разметка notification_chrolingo_compact. Верхняя граница здесь —
     около 88dp: столько отводится всплывающему.

     На Android 11 и старше система в разметку не вмешивается вовсе:
     это и есть ВСЁ уведомление, от края до края, без шапки и без белой
     рамки. Поэтому фон скруглён как карточка, а не как плашка внутри
     чужой карточки.

     Цвета НЕ ЗАДАНЫ ЗДЕСЬ НАРОЧНО: и фон, и цвет текста ставит
     RichNotifications.kt под каждый вид уведомления. Иначе на каждую
     расцветку понадобился бы свой файл разметки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Тикает сам, силами системы. Приложение к этому моменту давно
             закрыто, обновлять счётчик некому — и не нужно. -->
        <Chronometer
            android:id="@+id/reminder_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminder_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/reminder_mascot"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</LinearLayout>
